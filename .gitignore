# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local environment
.env

# Generated indexes and caches
chroma_db/
bm25_index/
.csrs_cache/

# Corpus: standards are fetched by scripts/fetch_docs.py, not committed.
# The exception is docs/samples/, which ships public-domain text so a fresh
# clone runs immediately.
docs/*.pdf
docs/*.txt
!docs/samples/
# Experiment corpus additions: ISO 27001:2022 is a licensed, user-provided
# document (never commit it); SP 800-53r5 is fetched, not shipped.
docs/samples/ISO_IEC-270012022-ed.3.pdf
docs/samples/NIST.SP.800-53r5.pdf
# Snort rule documentation is fetched by scripts/fetch_snort_rule_docs.py
# (Cisco-copyrighted pages, no NIST-style public-domain exception). The same
# applies to the preprocessed rule-doc bundle the corpus is now rendered from.
docs/samples/snort_rule_*.txt
docs/rule_docs_preprocessed_by_sid.json

# Evaluation runs
eval/results/

# macOS
.DS_Store

# Built PDFs (rebuild with ./latex/build.sh and ./latex/build.sh --slides)
CSRS_Work_Record.pdf
latex/CSRS_Work_Record.pdf
CSRS_Presentation.pdf
latex/CSRS_Presentation.pdf
